@model EXOformulaire.Models.Auth.RegisterViewModel;

@{
    var colWidth = ViewData["RegisterCol"] != null ? ViewData["RegisterCol"] as int? : 4;
    var flexAlign = ViewData["FlexRegisterPos"] != null ? ViewData["FlexRegisterPos"] as string : "justify-content-center";

}

@using (Html.BeginForm("Register", "Auth", FormMethod.Post, new { id = "register-form", @class = "register-form" }))
{
    @Html.AntiForgeryToken();
    <div class="container w-100 h-100  d-flex @flexAlign">
        <div id="registerForm" class="col-@colWidth d-flex justify-content-center align-items-center ">
            <div class="d-flex row col-12 bg-dark rounded pb-4 px-2">
                <h3 class="text-light text-center my-4">Register</h3>
                <fieldset>
                    @Html.LabelFor(m => m.Username)
                    @Html.TextBoxFor(m => m.Username, new
                    {
                        @class = "form-control",
                                placeHolder = "Your username...",
                                autocomplete = "on",
                                })
                @Html.ValidationMessageFor(m => m.Username)
            </fieldset>
            <div class="col-lg-12">
                <fieldset>
                    @Html.LabelFor(m => m.RegisterEmail)
                    @Html.TextBoxFor(m=>m.RegisterEmail,new{
                                        @class = "form-control",
                                        placeholder = "Your Email...",
                                        autocomplete = "on",
                                        })
                    @Html.ValidationMessageFor(m => m.RegisterEmail)
                </fieldset>
            </div>
            <div class="col-lg-12">
                <fieldset>
                    @Html.LabelFor(m => m.BirthDay)
                    @Html.TextBoxFor(m=>m.BirthDay, new{
                                        @class = "form-control",
                                        type = "date",
                                        })
                    @Html.ValidationMessageFor(m => m.BirthDay)
                </fieldset>
            </div>

            <div class="col-12 mb-3">
                <div class="input-group">
                    @Html.LabelFor(m => m.RegisterPassword, new { @class = "form-label text-light w-100" })
                    <div class="input-group">
                        @Html.TextBoxFor(m => m.RegisterPassword, new {
                                                @class = "form-control",
                                                type = "password",
                                                autocomplete = "autocomplete",
                                                id = "passwordInput"
                                                })
                        <button class="btn btn-outline-secondary" type="button" id="togglePassword" onclick="toogleIcon(this)"
                                style="height: 38px; border-color: #ced4da;">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.RegisterPassword, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="col-12 mb-3">
                <div class="input-group">
                    @Html.LabelFor(m => m.PasswordConfirmation, new { @class = "form-label text-light w-100" })
                    <div class="input-group">
                        @Html.TextBoxFor(m => m.PasswordConfirmation, new {
                                                @class = "form-control",
                                                type = "password",
                                                autocomplete = "autocomplete",
                                                id = "confirmPasswordInput"
                                                })
                        <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword" onclick="toogleIcon(this)"
                                style="height: 38px; border-color: #ced4da;">
                            <i id="passwordEyeLogo" class="fas fa-eye"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.PasswordConfirmation, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="col-12 my-3 d-flex justify-content-evenly">
                <button type="submit" class="btn btn-light btn-outline-primary">Register</button>
                <button type="reset" class="btn btn-light btn-outline-danger">Reset</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        function toogleIcon(el){
            const target = el.parentNode.firstChild.nextSibling;
            const type = target.getAttribute('type') === 'password' ? 'text' : 'password';
            target.setAttribute('type', type);

            const nTarget = el.firstChild.nextSibling;
            const currentIcon = nTarget.classList.contains("fa-eye") ? "fa-eye" : "fa-eye-slash";
            const newIcon = nTarget.classList.contains("fa-eye") ? "fa-eye-slash" : "fa-eye";
            nTarget.classList.remove(currentIcon);
            nTarget.classList.add(newIcon);
        }
        console.log();
    </script>

}


}