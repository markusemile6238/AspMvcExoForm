@model EXOformulaire.Models.Auth.RegisterViewModel;
@section Styles{
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}


@using (Html.BeginForm("Register", "Auth", FormMethod.Post, new { id = "register-form", @class = "register-form" }))
{
    @Html.AntiForgeryToken()
    ;


    <div class="d-flex row col-lg-4 bg-dark rounded m-5 p-5">
        <h3 class="text-light text-center">Register</h3>
        <fieldset>
            @Html.LabelFor(m => m.Username)
            @Html.TextBoxFor(m => m.Username, new
            {
                @class = "form-control",
                placeHolder = "Your username...",
                autocomplete = "on",
                required = "required"
                })
        @Html.ValidationMessageFor(m => m.Username)
    </fieldset>
    <div class="col-lg-12">
        <fieldset>
            @Html.LabelFor(m => m.Email)
            @Html.TextBoxFor(m=>m.Email,new{
                        @class = "form-control",
                        placeholder = "Your Email...",
                        autocomplete = "on",
                        required = "required"
                        })
            @Html.ValidationMessageFor(m => m.Password)
        </fieldset>
    </div>
    <div class="col-lg-12">
        <fieldset>
            @Html.LabelFor(m => m.BirthDay)
            @Html.TextBoxFor(m=>m.BirthDay, new{
                        @class = "form-control",
                        required = "required",
                        type = "date"
                        })
            @Html.ValidationMessageFor(m => m.BirthDay)
        </fieldset>
    </div>

    <div class="col-12 mb-3">
        <div class="input-group">
            @Html.LabelFor(m => m.Password, new { @class = "form-label text-light w-100" })
            <div class="input-group">
                @Html.TextBoxFor(m => m.Password, new {
                            @class = "form-control",
                            required = "required",
                            type = "password",
                            id = "passwordInput"
                            })
                <button class="btn btn-outline-secondary" type="button" id="togglePassword"
                        style="height: 38px; border-color: #ced4da;">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
        </div>
    </div>

    <div class="col-12 mb-3">
        <div class="input-group">
            @Html.LabelFor(m => m.PasswordConfirmation, new { @class = "form-label text-light w-100" })
            <div class="input-group">
                @Html.TextBoxFor(m => m.PasswordConfirmation, new {
                                @class = "form-control",
                                required = "required",
                                type = "password",
                                id = "confirmPasswordInput"
                                })
                <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword"
                        style="height: 38px; border-color: #ced4da;">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            @Html.ValidationMessageFor(m => m.PasswordConfirmation, "", new { @class = "text-danger small" })
        </div>
    </div>
</div>



}